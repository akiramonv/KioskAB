<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.kiosk.ui.controllers.AdminController"
            styleClass="admin-panel"
            prefWidth="900" prefHeight="650">

    <top>
        <VBox>
            <HBox styleClass="admin-header" alignment="CENTER_LEFT" spacing="16">
                <Label text="%admin.title" styleClass="admin-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="%admin.close" styleClass="btn-danger" onAction="#onClose"/>
            </HBox>
            <!-- Вкладки-пилюли, как в макете «Киоск — новый дизайн» -->
            <FlowPane styleClass="admin-tabs" hgap="8" vgap="8">
                <padding><Insets top="12" right="24" bottom="12" left="24"/></padding>
                <Button text="%admin.nav.users" styleClass="admin-nav-btn" onAction="#showUsers"/>
                <Button text="%admin.nav.services" styleClass="admin-nav-btn" onAction="#showServices"/>
                <Button text="%admin.nav.categories" styleClass="admin-nav-btn" onAction="#showCategories"/>
                <Button text="%admin.nav.providers" styleClass="admin-nav-btn" onAction="#showProviders"/>
                <Button text="%admin.nav.specializations" styleClass="admin-nav-btn" onAction="#showSpecializations"/>
                <Button text="%admin.nav.payments" styleClass="admin-nav-btn" onAction="#showPayments"/>
            </FlowPane>
        </VBox>
    </top>

    <center>
        <VBox styleClass="admin-content" spacing="12">
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

            <!-- Toolbar: поиск + кнопки -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <TextField fx:id="adminSearchField" promptText="%admin.search"
                           styleClass="search-field" prefWidth="220"
                           onKeyReleased="#onAdminSearch"/>
                <HBox fx:id="paymentFilters" spacing="8" alignment="CENTER_LEFT" visible="false" managed="false">
                    <ComboBox fx:id="paymentStatusFilter" promptText="Статус" prefWidth="130"
                              styleClass="filter-combo" onAction="#onAdminSearch"/>
                    <TextField fx:id="minAmountField" promptText="Сумма от" prefWidth="95"
                               styleClass="dialog-field" onKeyReleased="#onAdminSearch"/>
                    <TextField fx:id="maxAmountField" promptText="до" prefWidth="80"
                               styleClass="dialog-field" onKeyReleased="#onAdminSearch"/>
                    <DatePicker fx:id="dateFromPicker" promptText="Дата от" prefWidth="130"
                                onAction="#onAdminSearch"/>
                    <DatePicker fx:id="dateToPicker" promptText="до" prefWidth="120"
                                onAction="#onAdminSearch"/>
                    <Button text="%admin.reset" styleClass="btn-small" onAction="#onResetPaymentFilters"/>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="addBtn" text="%admin.add" styleClass="btn-primary"
                        onAction="#onAdd"/>
                <Button fx:id="editBtn" text="%admin.edit" styleClass="btn-outline"
                        onAction="#onEdit" disable="true"/>
                <Button fx:id="deleteBtn" text="%admin.delete" styleClass="btn-danger"
                        onAction="#onDelete" disable="true"/>
            </HBox>

            <!-- Таблица -->
            <TableView fx:id="adminTable" VBox.vgrow="ALWAYS" styleClass="admin-table">
                <placeholder>
                    <Label text="%admin.placeholder" styleClass="empty-label"/>
                </placeholder>
            </TableView>

            <Label fx:id="adminStatus" text="" styleClass="status-text"/>
        </VBox>
    </center>
</BorderPane>
