<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.kiosk.ui.controllers.ServiceDetailController"
      styleClass="detail-dialog"
      spacing="16"
      prefWidth="480">

    <padding><Insets top="32" right="40" bottom="32" left="40"/></padding>

    <Label fx:id="serviceNameLabel" text="" styleClass="detail-title" wrapText="true"/>

    <Separator/>

    <GridPane hgap="12" vgap="10" styleClass="detail-grid">
        <Label text="%detail.category" styleClass="detail-key" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <Label fx:id="categoryLabel" text="" styleClass="detail-val" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="%detail.provider" styleClass="detail-key" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <Label fx:id="providerLabel" text="" styleClass="detail-val" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="%detail.account" styleClass="detail-key" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <Label fx:id="accountLabel" text="" styleClass="detail-val" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label text="%detail.commission" styleClass="detail-key" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <Label fx:id="commissionLabel" text="" styleClass="detail-val" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
    </GridPane>

    <Separator/>

    <VBox spacing="8">
        <Label text="%detail.amount" styleClass="field-label"/>
        <TextField fx:id="amountField" promptText="%detail.amountPrompt" styleClass="dialog-field"/>
        <Label text="%detail.quantity" styleClass="field-label"/>
        <TextField fx:id="quantityField" promptText="%detail.quantityPrompt" text="1" styleClass="dialog-field"/>
        <Label fx:id="detailErrorLabel" text="" styleClass="error-label" visible="false" wrapText="true"/>
    </VBox>

    <Label text="%detail.hint" styleClass="detail-hint" wrapText="true"/>

    <HBox spacing="12" alignment="CENTER_RIGHT">
        <Button fx:id="favoriteBtn" text="%detail.favAdd" styleClass="btn-outline"
                onAction="#onFavorite"/>
        <Button text="%detail.add" styleClass="btn-primary"
                onAction="#onAddToCart"/>
        <Button text="%detail.close" styleClass="btn-outline"
                onAction="#onClose"/>
    </HBox>
</VBox>
