<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.kiosk.ui.controllers.ServiceDetailController"
      styleClass="detail-dialog"
      spacing="16"
      prefWidth="620">

    <padding><Insets top="18" right="44" bottom="36" left="44"/></padding>

    <HBox alignment="CENTER">
        <Region styleClass="sheet-handle" minWidth="80" maxWidth="80" minHeight="8" maxHeight="8"/>
    </HBox>

    <HBox spacing="14" alignment="CENTER_LEFT">
        <Label fx:id="serviceNameLabel" text="" styleClass="detail-title" wrapText="true"
               maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
        <Button fx:id="favoriteBtn" text="☆" styleClass="fav-btn" onAction="#onFavorite"/>
    </HBox>

    <GridPane hgap="14" vgap="14" styleClass="detail-grid">
        <columnConstraints>
            <ColumnConstraints percentWidth="50"/>
            <ColumnConstraints percentWidth="50"/>
        </columnConstraints>

        <VBox styleClass="detail-cell" spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label text="%detail.category" styleClass="detail-key"/>
            <Label fx:id="categoryLabel" text="" styleClass="detail-val" wrapText="true"/>
        </VBox>
        <VBox styleClass="detail-cell" spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label text="%detail.provider" styleClass="detail-key"/>
            <Label fx:id="providerLabel" text="" styleClass="detail-val" wrapText="true"/>
        </VBox>
        <VBox styleClass="detail-cell" spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1">
            <Label text="%detail.account" styleClass="detail-key"/>
            <Label fx:id="accountLabel" text="" styleClass="detail-val" wrapText="true"/>
        </VBox>
        <VBox styleClass="detail-cell" spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <Label text="%detail.commission" styleClass="detail-key"/>
            <Label fx:id="commissionLabel" text="" styleClass="detail-val" wrapText="true"/>
        </VBox>
    </GridPane>

    <VBox spacing="8">
        <Label text="%detail.amount" styleClass="field-label"/>
        <HBox spacing="10">
            <Button text="100" styleClass="amount-chip" maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#onAmountChip"/>
            <Button text="200" styleClass="amount-chip" maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#onAmountChip"/>
            <Button text="500" styleClass="amount-chip" maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#onAmountChip"/>
            <Button text="1000" styleClass="amount-chip" maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#onAmountChip"/>
        </HBox>
        <TextField fx:id="amountField" promptText="%detail.amountPrompt" styleClass="dialog-field"/>
    </VBox>

    <HBox spacing="14" alignment="CENTER_LEFT">
        <Label text="%detail.quantity" styleClass="field-label"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="−" styleClass="qty-btn" onAction="#onQtyMinus"/>
        <TextField fx:id="quantityField" text="1" styleClass="dialog-field, qty-field" prefWidth="86"/>
        <Button text="+" styleClass="qty-btn" onAction="#onQtyPlus"/>
    </HBox>

    <Label fx:id="detailErrorLabel" text="" styleClass="error-label" visible="false" managed="false" wrapText="true"/>

    <Label text="%detail.hint" styleClass="detail-hint" wrapText="true"/>

    <Button text="%detail.add" styleClass="btn-primary" maxWidth="Infinity"
            onAction="#onAddToCart"/>
    <Button text="%detail.close" styleClass="btn-outline" maxWidth="Infinity"
            onAction="#onClose"/>
</VBox>
